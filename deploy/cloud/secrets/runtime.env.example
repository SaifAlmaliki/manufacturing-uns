# Copy to runtime.env and fill before `docker compose up`.
# Do not commit runtime.env. Injected via compose env_file; not baked into images.

UNS_CONSOLE_ORIGIN=https://iip.example.com
UNS_KEYCLOAK_ADMIN_USERNAME=cloud-admin
UNS_KEYCLOAK_ADMIN_PASSWORD=
UNS_keycloak__admin_password=
UNS_keycloak__db_password=
UNS_keycloak__grafana_client_secret=
UNS_KEYCLOAK_GRAFANA_CLIENT_SECRET=
PGPASSWORD=
UNS_graphdb__password=
UNS_historian__password=
UNS_KAFKA_RETENTION_MS=604800000

# Lake mapper (AWS S3). Leave blank until the bucket and IAM user exist.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
UNS_datalake__s3__endpoint_url=https://s3.eu-central-1.amazonaws.com
UNS_datalake__s3__bucket=uns-historic-events
UNS_datalake__s3__region=eu-central-1
