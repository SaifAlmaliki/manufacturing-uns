FROM python:3.14-slim
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/test/support/generate_qualification_ca.sh /app/
RUN chmod +x /app/generate_qualification_ca.sh \
    && /app/generate_qualification_ca.sh /qualification-ca
RUN pip install --no-cache-dir confluent-kafka minio paho-mqtt
COPY deploy/test/support/*.py /app/
ENTRYPOINT ["python"]
