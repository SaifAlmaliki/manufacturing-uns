<?xml version="1.0" encoding="UTF-8" ?>
<hivemq xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <mqtt-listeners>
        <tcp-listener>
            <port>1883</port>
            <bind-address>0.0.0.0</bind-address>
        </tcp-listener>
    </mqtt-listeners>
    <admin-api>
        <enabled>true</enabled>
        <listeners>
            <http-listener>
                <port>8080</port>
                <bind-address>0.0.0.0</bind-address>
            </http-listener>
        </listeners>
    </admin-api>
    <!--
        HiveMQ Edge simulators (not a real PLC).
        protocolId "simulation" invents random values and publishes them to MQTT.
        Replace this block with opcua / eip / s7 / modbus adapters for plant ingest.
    -->
    <protocol-adapters>
        <protocol-adapter>
            <adapterId>sim</adapterId>
            <protocolId>simulation</protocolId>
            <config>
                <minValue>0</minValue>
                <maxValue>1000</maxValue>
                <minDelay>0</minDelay>
                <maxDelay>0</maxDelay>
                <simulationToMqtt>
                    <pollingIntervalMillis>1000</pollingIntervalMillis>
                    <maxPollingErrorsBeforeRemoval>-1</maxPollingErrorsBeforeRemoval>
                </simulationToMqtt>
            </config>
            <northboundMappings>
                <northboundMapping>
                    <topic>test/uns/edge/sim</topic>
                    <tagName>t1</tagName>
                    <maxQos>1</maxQos>
                    <includeTimestamp>true</includeTimestamp>
                </northboundMapping>
            </northboundMappings>
            <tags>
                <tag>
                    <name>t1</name>
                    <description>Edge simulation tag</description>
                    <definition/>
                </tag>
            </tags>
        </protocol-adapter>
        <protocol-adapter>
            <adapterId>catalog-srv_mtrnvz29_q0b171</adapterId>
            <protocolId>s7</protocolId>
            <config>
                <host>10.0.0.6</host>
                <port>103</port>
                <controllerType>S7_300</controllerType>
            </config>
            <northboundMappings>
                <northboundMapping>
                    <topic>Acme/Line/Speed</topic>
                    <tagName>ID103</tagName>
                    <maxQos>1</maxQos>
                    <includeTimestamp>true</includeTimestamp>
                </northboundMapping>
            </northboundMappings>
            <tags>
                <tag>
                    <name>ID103</name>
                    <description>Speed from S7</description>
                    <definition>
                        <tagAddress>%ID103</tagAddress>
                        <dataType>DINT</dataType>
                    </definition>
                </tag>
            </tags>
        </protocol-adapter>
        <protocol-adapter>
            <adapterId>catalog-srv_mtrnx3r2_f5smo2</adapterId>
            <protocolId>eip</protocolId>
            <config>
                <host>10.0.0.8</host>
                <port>44818</port>
            </config>
            <northboundMappings>
                <northboundMapping>
                    <topic>Acme/Line1/Temperature</topic>
                    <tagName>ID103</tagName>
                    <maxQos>1</maxQos>
                    <includeTimestamp>true</includeTimestamp>
                </northboundMapping>
            </northboundMappings>
            <tags>
                <tag>
                    <name>ID103</name>
                    <description>Temperature from Ethernet-IP PLC</description>
                    <definition>
                        <address>%ID103</address>
                        <dataType>DINT</dataType>
                    </definition>
                </tag>
            </tags>
        </protocol-adapter>
    </protocol-adapters>
</hivemq>
